<?xml version="1.0" encoding="UTF-8"?>
<!--
  Public-page sitemap. Operators with a configured ZV_PUBLIC_URL get
  absolute URLs at request time (server.go rewrites the {{HOST}}
  placeholder); without it, the URLs render as origin-relative which
  most crawlers treat as fine.

  Update lastmod when the manual or landing copy changes meaningfully.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{HOST}}/</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{HOST}}/manual</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{HOST}}/pricing</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{HOST}}/store</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  {{ORG_URLS}}
  <url>
    <loc>{{HOST}}/privacy</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>{{HOST}}/terms</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>

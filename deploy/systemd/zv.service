[Unit]
# Zonventure server — for operators running the native binary instead
# of the Docker compose stack. Pairs with a Postgres reachable via
# DATABASE_URL (set in /etc/zv/zv.env) and, typically, a reverse
# proxy in front terminating TLS.
Description=Zonventure server
Documentation=https://git.sr.ht/~klahr/zv
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple

# Drop privileges to a dedicated system user. Create with:
#   useradd --system --no-create-home --shell /usr/sbin/nologin zv
User=zv
Group=zv

# Single static binary; install with:
#   install -m 0755 zv /usr/local/bin/zv
ExecStart=/usr/local/bin/zv

# All ZV_* + DATABASE_URL come from a root-owned env file so secrets
# don't end up in the unit (which is world-readable). Create with:
#   install -m 0640 -o root -g zv zv.env /etc/zv/zv.env
EnvironmentFile=/etc/zv/zv.env

# Restart on crash with backoff; if the service flaps faster than the
# StartLimit window the unit goes into "failed" so a real bug in the
# config doesn't burn CPU in a tight loop.
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

# Hardening — most of these are no-ops for a Go HTTP server but make
# a sandbox escape via a dependency CVE meaningfully harder. None of
# them require root or network namespaces.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# Relaxed where required: the binary needs to bind a port, talk to
# Postgres + SMTP + Stripe, and write nothing to disk by default.
# AF_UNIX is included for callers using a postgres unix socket.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateDevices=true
ProtectHostname=true

# Default listener is :8080. The reverse proxy points at it on
# 127.0.0.1; if you change ZV_BIND_ADDR remember to keep nginx/Caddy
# in sync.
AmbientCapabilities=
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target

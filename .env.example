# Copy to .env and edit for production. compose.yaml falls back to these
# defaults for local dev so the file is optional.
POSTGRES_DB=zv
POSTGRES_USER=zv
POSTGRES_PASSWORD=zv

# Transactional email. Leave ZV_SMTP_HOST blank in dev to log mail
# instead of sending. Fill the rest when you wire a real provider
# (SES SMTP, SendGrid, Postmark, Mailgun, your own postfix, etc.).
ZV_SMTP_HOST=
ZV_SMTP_PORT=587
ZV_SMTP_USER=
ZV_SMTP_PASS=
ZV_SMTP_FROM=
ZV_SMTP_TLS=starttls

# Legal pages (/privacy and /terms) splice these into the templates at
# request time. Empty values render obvious "[set ZV_*]" placeholders;
# fill in before pointing customers at the pages, and have a lawyer
# review the templates themselves before going live.
ZV_COMPANY_NAME=
ZV_CONTACT_EMAIL=
ZV_DPO_EMAIL=
ZV_JURISDICTION=
ZV_LEGAL_LAST_UPDATED=
ZV_LOCATION_RETENTION_DAYS=30
ZV_AUDIT_RETENTION_DAYS=90

# Stripe payments. Both vars must be set to enable provider=stripe on
# purchases — without the webhook secret we'd accept arbitrary "paid"
# claims. Test keys (sk_test_..., whsec_...) work for local dev with
# Stripe CLI's `stripe listen --forward-to localhost:8080/api/webhooks/stripe`.
#
# Stripe Tax: the server passes automatic_tax: true on every checkout
# session, which is a no-op until you enable Stripe Tax in your
# Dashboard (Settings → Tax → Get started) and configure the tax
# registrations for the jurisdictions you sell into. No code changes
# needed when you flip it on; the next checkout starts collecting tax.
ZV_STRIPE_SECRET_KEY=
ZV_STRIPE_WEBHOOK_SECRET=

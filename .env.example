# Copy to `.env` and tune for your deployment. compose.yaml falls back
# to the defaults in this file, so `.env` is optional for the very
# first `docker compose up -d` — but you really should set the marked
# values before pointing real users at the box.

# ---- First-run admin ------------------------------------------------
# Created on the first boot when no admin yet exists, then ignored
# forever after. Set BEFORE first boot for a custom credential, or
# delete the line after you log in and change the password through the
# UI.
ZV_SEED_ADMIN=admin:admin

# ---- Database -------------------------------------------------------
# Used by the bundled Postgres container. Change POSTGRES_PASSWORD
# before going to production.
POSTGRES_DB=zv
POSTGRES_USER=zv
POSTGRES_PASSWORD=zv

# ---- Public origin --------------------------------------------------
# Origin used in outbound emails and links. Defaults to localhost so
# the local stack works out of the box; set to your real https URL
# before you put it in front of users.
ZV_PUBLIC_URL=http://localhost:8080

# ---- Host bind ------------------------------------------------------
# By default the app listens on 127.0.0.1:8080 so a reverse proxy
# (Caddy/nginx/Traefik) on the same host owns TLS + the public port.
# Set ZV_BIND_ADDR=0.0.0.0 to expose directly (only sensible for
# single-host deployments behind a firewall).
ZV_BIND_ADDR=127.0.0.1
ZV_PORT=8080

# ---- Trusted reverse proxies ----------------------------------------
# Comma-separated CIDR/IP list naming the proxies whose X-Forwarded-For
# / X-Forwarded-Proto we honour. Empty (the default) is the safe
# direct-reachable posture: forwarded headers are ignored, so an
# attacker can't spoof their source IP to bypass the per-IP rate
# limiter / audit logging. Set this to your proxy's address when you
# put nginx/Caddy/Traefik in front of the app.
#   Same-host proxy:  127.0.0.1,::1
#   Same-host proxy, app in this compose stack: the network gateway,
#     docker network inspect <project>_default \
#       -f '{{(index .IPAM.Config 0).Gateway}}'
#   Private VPC:      10.0.0.0/8
#   Cloudflare-only:  173.245.48.0/20,103.21.244.0/22,...
ZV_TRUSTED_PROXIES=

# ---- Logging --------------------------------------------------------
# `text` for human reading, `json` to ship one object per line to a
# log aggregator (Loki, Datadog, CloudWatch, …).
ZV_LOG_FORMAT=text

# ---- Public landing page (optional) ---------------------------------
# Off by default: a self-host deployment is an app, not a marketing
# site, so unauthenticated visitors land directly on /arrange and
# /pricing 404s. Set to `true` to expose `/` and `/pricing` (e.g. for
# the hosted product). When set, this hard-overrides the admin
# Settings toggle — leave blank to keep the toggle live.
ZV_LANDING_ENABLED=

# ---- MCP connector (optional) ---------------------------------------
# Off by default. Set to `1` to mount POST /mcp so arrangers can
# connect Claude / other MCP clients and author adventures via tool
# calls. Each user mints their own bearer token from
# Settings → Account → MCP API tokens. See MCP.md for the full
# tool surface and security posture.
ZV_MCP_ENABLED=

# ---- Mail (optional) ------------------------------------------------
# Leave ZV_SMTP_HOST blank in dev — verification + reset links land in
# the container log instead. Fill the rest when you wire SES SMTP /
# SendGrid / Postmark / Mailgun / a self-hosted postfix.
ZV_SMTP_HOST=
ZV_SMTP_PORT=587
ZV_SMTP_USER=
ZV_SMTP_PASS=
ZV_SMTP_FROM=
ZV_SMTP_TLS=starttls

# ---- Legal pages (optional) -----------------------------------------
# /privacy and /terms splice these into the templates at request time.
# Empty values render obvious "[set ZV_*]" placeholders; fill in
# before pointing customers at the pages, and have a lawyer review the
# templates themselves before going live.
ZV_COMPANY_NAME=
ZV_CONTACT_EMAIL=
ZV_DPO_EMAIL=
ZV_JURISDICTION=
ZV_LEGAL_LAST_UPDATED=
# Sub-processors listed on /privacy. Use the legal name as it would
# appear in a DPA — e.g. "Hetzner Online GmbH (Germany)" or
# "Postmark (ActiveCampaign LLC, USA)". Required if you publish the
# privacy page to real users.
ZV_HOSTING_PROVIDER=
ZV_EMAIL_PROVIDER=
# Set to 1 once a lawyer has reviewed the rendered /privacy and /terms
# pages and you're satisfied with the wording for your jurisdiction.
# Strips the yellow "draft template — needs lawyer review" banners.
# Leave empty during self-host onboarding so the warning stays visible.
ZV_LEGAL_REVIEWED=
ZV_LOCATION_RETENTION_DAYS=30
ZV_AUDIT_RETENTION_DAYS=90

# ---- Postgres connection pool (optional) ----------------------------
# Defaults are tuned for a single-host self-host deployment: 25 max
# open connections (well under Postgres' 100-connection default), 5
# idle kept warm. Bump when you scale to a managed Postgres with a
# higher max_connections cap or are running multiple zv replicas off
# the same database.
ZV_DB_MAX_OPEN_CONNS=
ZV_DB_MAX_IDLE_CONNS=

# ---- Payments provider (optional) -----------------------------------
# Picks which payments.Provider impl backs the checkout / refund /
# webhook surface. Empty (the default) auto-picks "stripe" when the
# Stripe vars below are set, otherwise leaves payments unconfigured
# (the buy / store flows return "not enabled"). Set explicitly to
# "simulated" to use the dev-only auto-confirming impl — only valid
# alongside ZV_ENV=dev (the server panics on startup otherwise).
# Other accepted values land here as new subpackages graduate
# (Mollie / Paddle / Adyen / …).
ZV_PAYMENTS_PROVIDER=

# Deployment environment label. The only behaviour keyed on it today
# is the safety gate on ZV_PAYMENTS_PROVIDER=simulated, which refuses
# to wire unless this is "dev" or "development". Empty counts as
# non-dev, so a default-config deploy can never accidentally accept
# fake payments. Leave unset in production / staging.
ZV_ENV=

# Cutover redirect target. When set, every non-allowlisted request
# 301s to this URL with the original path + query preserved. Used
# during a self-host → hosted migration so existing token-bearing
# URLs (printed QR codes, emailed magic links, /team/{token}
# bookmarks) keep working through the cutover. The same flag can be
# flipped from the admin GUI (#migrate page) on a running instance
# without restarting; this env var pins the value (admin UI shows the
# pin and disables the toggle). Allowlisted: /api/health,
# /api/version, /api/webhooks/stripe, /api/admin/migrate/redirect-mode.
ZV_REDIRECT_TARGET=

# Maintenance mode. When "1"/"true"/"on", every non-allowlisted
# mutation (POST/PUT/PATCH/DELETE) returns 503 until the flag is
# cleared. Reads pass through. Used to freeze writes during an
# org-bundle export so the snapshot can't be torn by concurrent
# player progression. The flag is also flippable from the admin
# GUI (#migrate page) on a running instance without restarting;
# this env var pins the value (admin UI shows the pin and disables
# the toggle). Allowlisted endpoints during the freeze: /api/health,
# /api/version, all /api/admin/migrate/*, all /api/auth/*.
ZV_MAINTENANCE_MODE=

# ---- Stripe (optional) ----------------------------------------------
# Both vars must be set to enable real payments. Without them the
# simulated checkout creates assignments directly — fine for self-host
# operators who only run their own org. Test keys (sk_test_…,
# whsec_…) work for local dev with `stripe listen --forward-to
# localhost:8080/api/webhooks/stripe`.
#
# Stripe Tax: the server passes automatic_tax: true on every checkout
# session, which is a no-op until you enable Stripe Tax in your
# Dashboard (Settings → Tax → Get started) and configure tax
# registrations for the jurisdictions you sell into. No code changes
# needed when you flip it on.
#
# Customer Portal: the "Update payment method" button on /arrange's
# Purchases tab opens the Stripe-hosted Customer Portal. Enable it
# once in your Stripe Dashboard (Settings → Customer portal →
# Activate) — there's no separate env var; the secret key above is
# all the API surface needs.
ZV_STRIPE_SECRET_KEY=
ZV_STRIPE_WEBHOOK_SECRET=

# ---- Marketplace platform fee (optional) ----------------------------
# When set, /store ticket sales are destination-charged into the
# selling org's Stripe Connect account with a per-charge platform
# fee taken off the top — i.e. the hosted-instance posture, where
# the platform charges a cut on each ticket sold. Both default to
# 0; with both unset the marketplace flow is entirely inert and
# /store sales land directly in the platform Stripe account
# (the right self-host posture).
#
# Fee formula: max(percent_of_price, floor). A flat €5 would crush
# an €8 family ticket; a flat percentage would trail off on a €120
# corporate ticket. The hybrid `max(8%, €1)` matches Eventbrite /
# Tito conventions.
#
# Activating this REQUIRES enabling Stripe Connect on your platform
# Stripe account first (Dashboard → Connect → Get started). Without
# Connect approval, /store/buy will fail at checkout time. Each
# selling org then onboards a Standard Connect account from
# arrange's Settings → Billing tab; quests stay hidden from /store
# until the org's account.charges_enabled becomes true.
ZV_PLATFORM_FEE_PERCENT_BPS=
ZV_PLATFORM_FEE_MIN_CENTS=

# ---- Single sign-on (optional) --------------------------------------
# OpenID Connect — primarily Google Workspace, but any compliant
# provider works. Off by default: SSO endpoints 404 and the login
# screen stays password-only. Set ZV_OIDC_ENABLED=1 plus the five
# required values below to turn it on; the app validates at boot and
# refuses to start on misconfiguration. Full walkthrough (Google
# Cloud Console steps, redirect URI, JIT-provisioning rules) lives
# in SELFHOSTING.md → "Single sign-on (Google Workspace)".
ZV_OIDC_ENABLED=
ZV_OIDC_ISSUER=https://accounts.google.com
ZV_OIDC_CLIENT_ID=
ZV_OIDC_CLIENT_SECRET=
# Workspace primary domain — only users with this email domain can
# sign in via SSO. Required; locks the deployment to one tenant.
ZV_OIDC_HOSTED_DOMAIN=
# Must exactly match the Authorised redirect URI you registered with
# the IdP (no trailing slash).
ZV_OIDC_REDIRECT_URL=
# Optional. Names the org JIT-provisioned SSO users join. Defaults
# to ZV_OIDC_HOSTED_DOMAIN.
ZV_OIDC_ORG_NAME=
# Optional. Override the default "Sign in with Google" button label
# and the users.oidc_provider value (default "google") — useful when
# pointing at Microsoft Entra, Okta, or another non-Google IdP.
ZV_OIDC_BUTTON_LABEL=
ZV_OIDC_PROVIDER_NAME=

# ---- Two-factor authentication (optional) ---------------------------
# Set to enable opt-in TOTP 2FA. The value is the AES-256-GCM key that
# wraps each user's TOTP secret at rest. Generate once with
#
#   openssl rand -base64 32
#
# and store alongside POSTGRES_PASSWORD in your secrets backup —
# losing the key forces every enrolled user to re-enrol from scratch
# (a DB restore paired with a different key is equivalent to losing
# the key entirely). When unset, the Settings → Two-factor card
# shows a "not configured" placeholder and the login flow stays
# password-only; existing users keep working unchanged.
ZV_TOTP_KEY=
